# Envoy static bootstrap config for the Kaiten OSS core — the single
# entry point in front of `api`, and the only place a caller's
# identity is verified.
#
# This is the whole config: there is no second, "hosted" variant here.
# Identity is a JWT signed with KAITEN_DEV_JWT_SECRET (HS256), served as a
# JWKS by the local-jwks container (see ../../compose.yml), or a Kaiten
# credential — an organization access token (`ksh_*`) — exchanged for an
# internal JWT through ext_authz. Platform tokens (`ksm_*`) are NOT accepted
# here: the Platform API is internal-only and authenticates them itself, on a
# port this proxy does not front.
# Self-hosters point the jwt_authn provider below at their own issuer's
# JWKS; nothing else has to change.
#
# Hosted-service concerns — a third-party identity provider as the JWT issuer,
# webhook signature verification, routes into services that live outside this
# repository, and the handful of paths UNDER /api that such a service answers
# rather than the api container (/api/webhooks, /api/demo) — are NOT here. They
# live with the service that owns them, and a stack that needs them supplies
# its own Envoy config in place of this file. Keeping them out means this stack
# has no route, cluster, or secret that only makes sense for a vendor.
#
# Note what that split does NOT mean: /api is one API surface to every
# caller, whichever config is in play. A self-hosted deployment simply has no
# /api/webhooks, the same way it has no webhook delivery service — not a
# different base URL for it. The app never addresses a service, only a path, so
# nothing in ../../app has to know which Envoy config is in play.
#
# Envoy's static bootstrap has no built-in env-var substitution, so this
# file is a template: the envoy compose service renders it with `sed`
# before starting envoy (see compose.yml), substituting __KAITEN_APP_URL__
# and __KAITEN_PORT__.
admin:
  address:
    socket_address: { address: 0.0.0.0, port_value: 8080 }

# Internal listeners are opt-in: without this extension the
# `envoy_internal_address` endpoint on the token_validate cluster below
# fails to resolve at config load. See the token_validate_internal
# listener for what it is for.
bootstrap_extensions:
  - name: envoy.bootstrap.internal_listener
    typed_config:
      "@type": type.googleapis.com/envoy.extensions.bootstrap.internal_listener.v3.InternalListener

static_resources:
  listeners:
    - name: web
      address:
        socket_address: { address: 0.0.0.0, port_value: 80 }
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: web
                generate_request_id: true
                common_http_protocol_options:
                  idle_timeout: 60s
                request_timeout: 10s
                tracing:
                  provider:
                    name: envoy.tracers.opentelemetry
                    typed_config:
                      "@type": type.googleapis.com/envoy.config.trace.v3.OpenTelemetryConfig
                      service_name: envoy
                      grpc_service:
                        envoy_grpc:
                          cluster_name: jaeger_otlp
                        timeout: 1s
                route_config:
                  name: web_routes
                  virtual_hosts:
                    - name: web
                      domains: ["*"]
                      typed_per_filter_config:
                        envoy.filters.http.cors:
                          "@type": type.googleapis.com/envoy.extensions.filters.http.cors.v3.CorsPolicy
                          allow_origin_string_match:
                            - exact: "__KAITEN_APP_URL__"
                          allow_methods: "GET, POST, PUT, PATCH, DELETE, OPTIONS"
                          allow_headers: "content-type,authorization"
                          expose_headers: "content-type,authorization"
                          max_age: "100"
                          allow_credentials: true
                      routes:
                        # ---- /api/public — the public SDK surface (pk_) ----
                        # A vendor's web page reads its public catalogue here
                        # with a publishable key in X-Kaiten-Publishable-Key.
                        # Neither jwt_authn nor ext_authz runs: the API verifies
                        # the key itself, by digest, and refuses any request
                        # carrying Authorization on these paths. Its own CORS
                        # policy, because the virtual host's (one exact origin,
                        # credentials) would refuse every vendor origin: any
                        # origin, never credentials -- no cookie is read or set
                        # here -- and the per-key origin allowlist is enforced
                        # by the API on the actual request, since a preflight
                        # carries no key to check.
                        - match: { prefix: "/api/public/" }
                          route: { cluster: api }
                          typed_per_filter_config:
                            envoy.filters.http.jwt_authn:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                              disabled: true
                            envoy.filters.http.ext_authz.pat:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthzPerRoute
                              disabled: true
                            envoy.filters.http.cors:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.cors.v3.CorsPolicy
                              allow_origin_string_match:
                                - safe_regex: { regex: ".*" }
                              allow_methods: "GET, OPTIONS"
                              allow_headers: "content-type,x-kaiten-publishable-key"
                              max_age: "600"
                              allow_credentials: false
                        # ---- /api/docs, /api/openapi*, /api/healthz — public ----
                        - match: { prefix: "/api/docs" }
                          route: { cluster: api }
                          typed_per_filter_config:
                            envoy.filters.http.jwt_authn:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                              disabled: true
                            envoy.filters.http.ext_authz.pat:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthzPerRoute
                              disabled: true
                        - match: { prefix: "/api/openapi" }
                          route: { cluster: api }
                          typed_per_filter_config:
                            envoy.filters.http.jwt_authn:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                              disabled: true
                            envoy.filters.http.ext_authz.pat:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthzPerRoute
                              disabled: true
                        # There is deliberately no /api/platform-openapi route
                        # any more. That document moved to the API's internal
                        # listener along with the operations it describes
                        # (KAITEN_PLATFORM_API_PORT), so this proxy has nothing
                        # to forward it to. Read it straight off the API
                        # container in the local stack:
                        #   http://localhost:${KAITEN_PLATFORM_PORT}/api/docs
                        - match: { prefix: "/api/healthz" }
                          route: { cluster: api }
                          typed_per_filter_config:
                            envoy.filters.http.jwt_authn:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                              disabled: true
                            envoy.filters.http.ext_authz.pat:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthzPerRoute
                              disabled: true
                        # ---- /api/v1/notifications/stream — SSE ----
                        #
                        # Two things this route needs that no other one does,
                        # and both mirror the deployed chart:
                        #
                        #   timeout: 0s   Envoy's default route timeout (15s)
                        #                 cuts a stream mid-flight, forever.
                        #   requires      the cookie-capable JWT provider, since
                        #                 EventSource sends no Authorization
                        #                 header. ext_authz is disabled here for
                        #                 the same reason: it authenticates a
                        #                 ksh_ header that a browser cannot send.
                        - match: { path: "/api/v1/notifications/stream" }
                          route:
                            cluster: api
                            timeout: 0s
                          typed_per_filter_config:
                            envoy.filters.http.jwt_authn:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                              requirement_name: cookie_or_header
                            envoy.filters.http.ext_authz.pat:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthzPerRoute
                              disabled: true
                        # ---- /api with an organization credential (ksh_*) — ext_authz forwardAuth ----
                        # ksh_ ONLY. /api/tokens/validate
                        # is the Core API's ext_authz hook and exchanges
                        # organization credentials; it is not a general
                        # credential-exchange service.
                        #
                        # This regex used to be ks[hm]_, because the Platform
                        # API had no authentication of its own: a ksm_ was
                        # exchanged HERE, on the public listener, for a signed
                        # JWT the caller then presented to the internal port.
                        # The Platform listener now authenticates the raw ksm_
                        # against the database itself (see
                        # internal/platform/auth.PlatformMiddleware), so there
                        # is nothing left for this proxy to do with one — and
                        # the code that authenticates platform credentials is
                        # no longer reachable from the internet at all.
                        #
                        # A ksm_ presented here therefore matches no
                        # credential route, falls through to the jwt_authn
                        # route below, is not a JWT, and is refused 401 by the
                        # proxy. It never reaches the API.
                        - match:
                            prefix: "/api"
                            headers:
                              - name: authorization
                                string_match: { safe_regex: { regex: "^Bearer ksh_.*" } }
                          route: { cluster: api }
                          typed_per_filter_config:
                            envoy.filters.http.jwt_authn:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                              disabled: true
                        # ---- /api — local HS256 JWT ----
                        - match: { prefix: "/api" }
                          route: { cluster: api }
                          typed_per_filter_config:
                            envoy.filters.http.ext_authz.pat:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthzPerRoute
                              disabled: true
                http_filters:
                  - name: envoy.filters.http.lua
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
                      default_source_code:
                        inline_string: |
                          function envoy_on_request(request_handle)
                            local tp = request_handle:headers():get("traceparent")
                            if not tp then
                              -- No incoming trace context: synthesize one from
                              -- Envoy's own x-request-id (already a unique UUID
                              -- per request via generate_request_id, generated
                              -- earlier than any HTTP filter runs) instead of
                              -- math.random, which isn't per-request-seeded in
                              -- Envoy's Lua sandbox and would mint the SAME
                              -- "random" id for every request otherwise. A
                              -- receiver with a valid incoming traceparent
                              -- propagates it rather than minting an unrelated
                              -- one (W3C tracecontext), so Envoy's own tracer
                              -- adopts this as the trace it exports too.
                              local rid = request_handle:headers():get("x-request-id")
                              if rid then
                                local hex = rid:gsub("%-", "")
                                if #hex >= 32 then
                                  tp = "00-" .. hex:sub(1, 32) .. "-" .. hex:sub(1, 16) .. "-01"
                                  request_handle:headers():add("traceparent", tp)
                                end
                              end
                            end
                            if tp then
                              request_handle:streamInfo():dynamicMetadata():set("kaiten", "traceparent", tp)
                            end
                          end

                          function envoy_on_response(response_handle)
                            local md = response_handle:streamInfo():dynamicMetadata():get("kaiten")
                            if md and md.traceparent then
                              local trace_id = string.match(md.traceparent, "^%x%x%-(%x+)%-")
                              if trace_id then
                                response_handle:headers():add("Kaiten-TraceId", trace_id)
                              end
                            end
                          end
                  - name: envoy.filters.http.cors
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.cors.v3.Cors
                  - name: envoy.filters.http.jwt_authn
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication
                      providers:
                        local:
                          forward: true
                          from_headers:
                            - name: authorization
                              value_prefix: "Bearer "
                          payload_in_metadata: local_jwt_payload
                          remote_jwks:
                            http_uri:
                              uri: "http://local-jwks:8080/jwks.json"
                              cluster: local_jwks
                              timeout: 5s
                            cache_duration: 5s
                        # Same provider, same JWKS, read from the session cookie
                        # as well -- for the notification stream and nothing
                        # else. `EventSource` cannot set an Authorization
                        # header, so the credential has to arrive some other
                        # way, and this is the local mirror of what the chart
                        # does in a deployed environment (charts/kaiten
                        # templates/ingress/policies.yaml).
                        #
                        # A SECOND PROVIDER rather than adding from_cookies to
                        # the one above: cookie authentication on a mutating
                        # endpoint is a CSRF surface, so it is scoped to the one
                        # GET route by the requirement_map below. The header is
                        # still accepted, so curl works against this path too.
                        local_cookie:
                          forward: true
                          from_headers:
                            - name: authorization
                              value_prefix: "Bearer "
                          from_cookies:
                            - __session
                          payload_in_metadata: local_jwt_payload
                          remote_jwks:
                            http_uri:
                              uri: "http://local-jwks:8080/jwks.json"
                              cluster: local_jwks
                              timeout: 5s
                            cache_duration: 5s
                      requirement_map:
                        cookie_or_header:
                          provider_name: local_cookie
                      rules:
                        - match: { prefix: "/" }
                          requires:
                            provider_name: local
                  # The check request goes through the token_validate
                  # cluster, NOT straight at `api`, and carries no
                  # path_prefix. path_prefix is the only path control
                  # ext_authz itself offers and it PREPENDS to the original
                  # client request's path rather than replacing it
                  # (there is no working path_override in v1.31/v1.33 —
                  # confirmed by live container test), so the check would
                  # otherwise land on "/api/tokens/validate/<the original path>"
                  # and force the API to expose a wildcard, auth-bypassing
                  # route under that prefix. token_validate_internal
                  # rewrites the path to the fixed "/api/tokens/validate"
                  # instead, so the API exposes exactly one public path.
                  #
                  # `allowed_headers` triggers a soft Envoy deprecation
                  # warning at startup (harmless, no replacement field
                  # exists yet as of v1.33 — see AuthorizationRequest in
                  # the ext_authz proto reference).
                  - name: envoy.filters.http.ext_authz.pat
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthz
                      failure_mode_allow: false
                      http_service:
                        server_uri:
                          uri: "http://api"
                          cluster: token_validate
                          timeout: 2s
                        authorization_request:
                          allowed_headers:
                            patterns:
                              - exact: authorization
                        authorization_response:
                          allowed_upstream_headers:
                            patterns:
                              - exact: authorization
                  - name: envoy.filters.http.local_ratelimit
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.local_ratelimit.v3.LocalRateLimit
                      stat_prefix: rate_limit_public
                      # Sized for local development, where the seeder is by far
                      # the heaviest client: a bulk seed drives thousands of
                      # requests per second through here, because every gated
                      # create reports its own usage back through this same
                      # listener (dogfooding). At the previous 100/s this
                      # silently 429'd most of that traffic, and the API logged
                      # a "creation limit check failed, proceeding anyway" line
                      # per drop.
                      #
                      # This is a runaway-client guard for a laptop, not the
                      # deployed rate limit -- charts/kaiten sets that through
                      # its own BackendTrafficPolicy.
                      token_bucket:
                        max_tokens: 20000
                        tokens_per_fill: 20000
                        fill_interval: 1s
                      filter_enabled:
                        runtime_key: rate_limit_public_enabled
                        default_value: { numerator: 100, denominator: HUNDRED }
                      filter_enforced:
                        runtime_key: rate_limit_public_enforced
                        default_value: { numerator: 100, denominator: HUNDRED }
                  - name: envoy.filters.http.buffer
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.buffer.v3.Buffer
                      max_request_bytes: 4194304
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

    # ---- ext_authz check-request path pinning ----
    # ext_authz can only PREPEND to the original request path, which would
    # make every check land on "/api/tokens/validate/<whatever the client
    # asked for>" and force the API to publish a wildcard route under a
    # prefix that, by construction, bypasses its auth middleware. Sending
    # the check through this internal listener instead rewrites the path to
    # the fixed "/api/tokens/validate" first, so the API answers exactly one
    # public path and anything else under that prefix is a plain 404.
    #
    # This listener is reachable only via the token_validate cluster's
    # envoy_internal_address — it has no socket address, so nothing outside
    # this Envoy process can send it a request.
    - name: token_validate_internal
      internal_listener: {}
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: token_validate
                route_config:
                  name: token_validate_routes
                  virtual_hosts:
                    - name: token_validate
                      domains: ["*"]
                      routes:
                        # Matches everything and rewrites it to one constant
                        # path — the incoming path carries no information the
                        # validation handler uses (it reads the Authorization
                        # header only).
                        - match: { prefix: "/" }
                          route:
                            cluster: api
                            regex_rewrite:
                              pattern: { regex: "^.*$" }
                              substitution: "/api/tokens/validate"
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
  clusters:
    - name: api
      type: STRICT_DNS
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: api
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address: { address: api, port_value: __KAITEN_PORT__ }
    # The ext_authz check request's only hop: it enters the internal
    # listener above (which pins the path) and leaves through the `api`
    # cluster. Nothing else routes here.
    - name: token_validate
      load_assignment:
        cluster_name: token_validate
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    envoy_internal_address:
                      server_listener_name: token_validate_internal
    - name: local_jwks
      type: STRICT_DNS
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: local_jwks
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address: { address: local-jwks, port_value: 8080 }
    - name: jaeger_otlp
      type: STRICT_DNS
      lb_policy: ROUND_ROBIN
      typed_extension_protocol_options:
        envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
          "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
          explicit_http_config:
            http2_protocol_options: {}
      load_assignment:
        cluster_name: jaeger_otlp
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address: { address: jaeger, port_value: 4317 }
