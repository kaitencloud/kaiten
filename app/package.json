    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "oxc-parser": "^0.150.0",
    "playwright": "catalog:",
    "react-doctor": "^0.9.14",
    "rollup-plugin-visualizer": "^7.1.1",
    "shadcn": "^4.21.0",
    "storybook": "^10.6.0",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
