{
  "name": "kaiten-app",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "check": "pnpm run fmt:check && vp check --no-fmt src e2e && pnpm run check:architecture && pnpm run check:file-sizes",
    "check:fix": "pnpm run fmt && vp check --fix --no-fmt src e2e && pnpm run check:architecture && pnpm run check:file-sizes",
    "fmt": "vp fmt 'src/**/*.{ts,tsx,js,jsx,mjs,cjs}' 'e2e/**/*.{ts,tsx,js,jsx,mjs,cjs}' '!**/*.test.ts' '!**/*.test.tsx' '!**/*.stories.ts' '!**/*.stories.tsx' '!**/*.queries.ts' '!**/stories/**'",
    "fmt:check": "vp fmt --check 'src/**/*.{ts,tsx,js,jsx,mjs,cjs}' 'e2e/**/*.{ts,tsx,js,jsx,mjs,cjs}' '!**/*.test.ts' '!**/*.test.tsx' '!**/*.stories.ts' '!**/*.stories.tsx' '!**/*.queries.ts' '!**/stories/**'",
    "lint": "vp lint src e2e",
    "lint:fix": "vp lint --fix src e2e",
    "dev": "vp dev --port 3000",
    "start": "vp dev --port 3000",
    "build": "vp build && tsc",
    "build:ci": "./cel-engine/build.sh && vp build",
    "build:storybook": "storybook build",
    "build:wasm": "./cel-engine/build.sh",
    "react-doctor": "react-doctor . -y --verbose --no-ami",
    "serve": "vp preview",
    "test": "vp test run --project=unit",
    "test:watch": "vp test --project=unit",
    "test:coverage": "vp test run --project=unit --coverage",
    "test:stories": "vp test run --project=storybook",
    "test:stories:watch": "vp test --project=storybook",
    "test:all": "vp test run",
    "test:all:coverage": "vp test run --coverage",
    "test:cel-engine": "cargo test --locked --manifest-path cel-engine/Cargo.toml",
    "test:cel-engine:smoke": "node cel-engine/smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:all": "ALL_BROWSERS=true playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:app": "playwright test -c playwright.app.config.ts",
    "test:e2e:coverage:app": "pnpm coverage:e2e:clean && E2E_COVERAGE=true playwright test -c playwright.app.config.ts --project=chromium --workers=1 --timeout=60000 && pnpm coverage:merge",
    "test:e2e:codegen:app": "playwright codegen http://127.0.0.1:3100",
    "test:e2e:codegen:storybook": "playwright codegen http://127.0.0.1:6006",
    "test:e2e:visual:update:linux": "./scripts/update-visual-baselines-linux.sh",
    "test:coverage:combined": "pnpm test:coverage && pnpm test:e2e:coverage:app",
    "coverage:e2e:clean": "node scripts/merge-e2e-coverage.mjs --clean-e2e",
    "coverage:merge": "node scripts/merge-e2e-coverage.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "typecheck:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:e2e-contracts": "tsx --tsconfig tsconfig.e2e.json scripts/check-e2e-contracts.ts",
    "check:i18n-parity": "tsx scripts/check-i18n-parity.ts",
    "check:i18n-keys": "tsx scripts/check-i18n-keys.ts",
    "check:api-error-i18n": "tsx scripts/check-api-error-i18n.ts",
    "check:file-sizes": "tsx scripts/check-file-sizes.ts",
    "check:ci": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:e2e && pnpm run check:architecture && pnpm run check:e2e-contracts && pnpm run check:i18n-parity && pnpm run check:i18n-keys && pnpm run check:api-error-i18n && pnpm run check:file-sizes && node ../scripts/check-token-contrast.mjs && pnpm run test && vp build",
    "generate-api-sdk": "pnpm --fail-if-no-match --filter @kaiten/api-codegen run generate && vp fmt src/lib/api/scopes.gen.ts",
    "generate-graphql": "graphql-codegen --config codegen.ts",
    "generate": "vp run generate-api-sdk && vp run generate-graphql",
    "storybook": "storybook dev -p 6006"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
