# Copy this file to .env.local (git-ignored) and uncomment what you need. It sets
# what the app reads while `pnpm run dev` serves it or a build bakes it in. Vite
# exposes only VITE_* variables to the browser, and it reads .env.local for
# production builds too: keep the local-only ones below out of a file you build
# a deployment from. Put comments on their own line, never after a value.
#
# `task app` and `task dev` (repository root) export VITE_LOCAL_AUTH and
# VITE_API_URL, and Vite gives a variable already in the process environment
# priority over any .env file: a value here cannot override those two under a
# task. To change them, run `task app LOCAL_AUTH=false` or set VITE_API_URL in
# your shell first. This file is for running the app without those tasks, and for
# the variables they do not set (VITE_CLERK_PUBLISHABLE_KEY and the
# VITE_KAITEN_PLATFORM_* pair). It is not the file `task up` reads: that is the
# .env at the repository root, copied from ../.env.example.

# API base URL, ending in /api. Required in a production build, where the
# container also substitutes it at start-up. In dev the fallback is
# http://localhost:6060/api, the address `task up` publishes.
# VITE_API_URL=http://localhost:6060/api

# `true` signs in through the dev account switcher, with the tokens the local
# stack writes to dev/tokens.json, instead of Clerk. Local stacks only.
# VITE_LOCAL_AUTH=true

# Clerk publishable key, for real sign-in. Not used when VITE_LOCAL_AUTH=true.
# VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Optional. The API (ending in /api) of a Kaiten deployment that hosts the
# platform flags this app gates some of its own features on, and a
# read:feature_flags token for it. The token is shipped to every browser, so it
# must carry that one scope only. Unset, every platform flag is off.
# VITE_KAITEN_PLATFORM_API_URL=https://platform.example.com/api
# VITE_KAITEN_PLATFORM_FLAGS_TOKEN=your_read_feature_flags_token

# Tests and mocks only. Vite folds these in at build time.
#
# Skip sign-in and serve the API from Mock Service Worker: how the Playwright
# app suite (`pnpm run test:e2e:app`) starts the dev server.
# VITE_E2E_BYPASS_AUTH=true
# VITE_E2E_MSW=true
#
# Serve only the notifications endpoints from mocks; everything else reaches the
# real API.
# VITE_MOCK_NOTIFICATIONS=true
