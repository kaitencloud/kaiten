# Copy this file to .env and fill in the required values.
# Run `task dev` to start everything locally.
#
# Note: inline comments (key=value  # comment) are NOT supported — Docker Compose
# includes everything after the = as the value.

# ─── Core ─────────────────────────────────────────────────────────────────────

# The compose project name is NOT set here. Taskfile.yml passes
# --project-name, defaulting to kaiten-oss, and derives KAITEN_CONTAINER_PREFIX
# from it -- the two have to agree, and a value in this file could disagree
# silently. A second stack beside this one is
# `task up PROJECT=kaiten-wip`, plus its own copy of every port below: a project
# name isolates containers, networks and volumes, and nothing else. Two stacks
# publishing 6060 is the second one failing to bind.

# Port used by Envoy (the single entry point for the stack). The browser dials
# this port directly, so it has to be one browsers are willing to dial.
#
# It is deliberately NOT 6000. Port 6000 is X11, and Chromium, Firefox and
# Safari all carry it on their blocked-port list: they fail the request with
# ERR_UNSAFE_PORT inside the browser, before it ever reaches the network.
# Nothing looks wrong on the server side when that happens -- Envoy is healthy
# and answers curl the whole time -- so the only symptom is a frontend where
# every API call fails and no log anywhere names a port. Moving this back to
# 6000 reintroduces exactly that. If you change it, stay off the rest of the
# blocked list too (notably 6566, 6665-6669 and 6697).
KAITEN_PORT=6060

# The API's Platform API listener (/api/platform/**), published straight off the
# api container. It is deliberately NOT behind Envoy: the Platform API is
# internal, consumed by other services rather than by browsers, and keeping it on
# its own port is what stops it from being reachable through the public entry
# point above. Must differ from the API's own port -- the API refuses to start
# otherwise.
KAITEN_PLATFORM_PORT=6001

# Port used by `task app` / `task dev` for the local frontend
KAITEN_APP_PORT=3000

# The frontend's own origin -- read by Envoy's CORS policy
# (docker/envoy/kaiten.yaml.tmpl) as the single origin CORS allows
# credentialed requests from -- CORS is enforced there alone, never in the
# API itself.
KAITEN_APP_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────

KAITEN_DATABASE_USER=kaiten
KAITEN_DATABASE_PASSWORD=kaiten
KAITEN_DATABASE=kaiten

# Host port mapped to Postgres inside Docker
KAITEN_DATABASE_PORT=5452

# Host ports for local infrastructure UIs and protocols
ENVOY_ADMIN_PORT=8080
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ─── Auth ─────────────────────────────────────────────────────────────────────
# There is one auth mode and it needs no account with anyone. Envoy verifies
# HS256 dev JWTs against this secret (served as a JWKS by the local-jwks
# container), and the `tokens` compose service (`task up`, `task quickstart`)
# signs the frontend user-switcher's tokens with it, into dev/tokens.json.
# Kaiten PATs (ksh_*) work too, and are exchanged for an internal JWT by
# Envoy's ext_authz.
#
# Any non-empty string works locally. Self-hosters who want a real identity
# provider point Envoy's jwt_authn at their own issuer's JWKS instead
# (docker/envoy/kaiten.yaml.tmpl) -- nothing else changes.
KAITEN_DEV_JWT_SECRET=change-me-in-local-dev

# ─── GraphQL ──────────────────────────────────────────────────────────────────

# Development affordances -- the playground at /api/graphql/playground and the
# introspection it reads the schema from. Both default OFF in the API and are
# turned ON for local dev by docker/config/api.yaml, not by a variable here:
# edit that file to turn them back off. Never enable them in a deployed
# environment: together they hand any authenticated caller an interactive
# console over the whole schema.

# ─── Observability ────────────────────────────────────────────────────────────

# Jaeger UI is always available at http://localhost:16686
# The default endpoint (jaeger:4318, this stack's own container) comes from
# docker/config/api.yaml. Set this only to forward traces to a remote
# collector instead -- an environment variable always overrides the file.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional Authorization header for the OTLP collector
# Format: Bearer <token>
OTEL_EXPORTER_OTLP_AUTHORIZATION=

# ─── Platform API ─────────────────────────────────────────────────────────────
# The host directory mounted at /credentials, holding the platform credential
# and the dev-switcher tokens.
# Taskfile.yml sets it to <repo>/dev, absolute; compose falls back to ./dev for
# anyone driving compose directly. Two stacks must not share one: the platform
# token is stored as a bcrypt hash in the database that minted it, so the second
# `bootstrap` to write here leaves the other stack holding a token its own
# database has never seen.
# KAITEN_DEV_DIR=./dev

# Where scripts/local-credentials.sh writes the platform credential it creates.
# Read by no server -- it is the one-shot's output path, and the compose
# bootstrap service sets it to a file under the ignored dev/ directory, 0600.
# The plaintext exists only at creation: it is stored as a bcrypt hash, so a lost
# file means minting a new credential, never recovering this one.
# KAITEN_PLATFORM_TOKEN_FILE=/credentials/platform-token
