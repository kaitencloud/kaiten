enum ConversionRuleStatus {
 ACTIVE
 ARCHIVED
}
enum AiRequestType {
 COMPLETION
 EMBEDDING
 IMAGE_GENERATION
 AUDIO
 VIDEO
}
enum ChargeOnErrorPolicy {
 NEVER
 ALWAYS
 PROVIDER_ERROR_ONLY
}
type ConversionRates {
 perRequest: String
 perInputToken: String
 perCachedInputToken: String
 perCacheWriteToken: String
 perOutputToken: String
 perUnit: String
 perSecond: String
}
"""An immutable license/pool/model/request identity with mutable exact pricing."""
type ConversionRule {
 id: UUID!
 licenseSlug: String!
 entitlementSlug: String!
 modelSlug: String
 requestType: AiRequestType
 rates: ConversionRates!
 minimumCreditsPerRequest: String!
 maximumCreditsPerRequest: String
 chargeOnError: ChargeOnErrorPolicy!
 status: ConversionRuleStatus!
 """Whether the licence itself grants the pool."""
 grantedByLicense: Boolean!
 """
 Whether an add-on version compatible with the licence's family grants the
 pool, whatever its lifecycle state: instances of the licence can then hold
 the pool without the licence granting it. License.addonGrants lists them.
 """
 grantedByAddons: Boolean!
 createdAt: Time!
 """Who created the rule. A service account is a user."""
 createdBy: User!
 updatedAt: Time!
 """Who last changed the rule: its pricing, or its archival."""
 updatedBy: User!
}
extend type License {
 """All rules when status is omitted; an explicit status filters that relation."""
 conversionRules(status: ConversionRuleStatus): [ConversionRule!]!
}
