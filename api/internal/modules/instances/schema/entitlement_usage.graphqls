"""Where an entitlement of an instance comes from."""
enum EntitlementUsageSource {
  """The licence grants it; add-ons, boosts and an exception may change it."""
  license
  """An add-on attached grants it."""
  addon
  """Only the instance's exception grants it."""
  exception
}

"""
The counters behind a RESOURCE entitlement's usage, which its value (the
highest of them) hides.
"""
type EntitlementUsageResources {
  """
  How many resources hold a counter for this entitlement on this instance,
  whatever their usage window.
  """
  count: Int!

  """
  How many of them have reached the limit in their current usage window; 0
  when the limit is unlimited.
  """
  atLimit: Int!
}

"""
Current usage of an entitlement on an instance. One row per license grant:
NUMBER entitlements carry the accumulated usage (zeroed when nothing has been
reported yet); other types carry the license value.
"""
type EntitlementUsage {
  entitlementId: UUID!
  entitlementSlug: String!
  licenseId: UUID!
  licenseSlug: String!

  """
  Typed usage value. Shapes: {type:"number",value:N,event_count:C},
  {type:"boolean",value:B}, {type:"object",value:{...}}
  """
  value: Map!

  """
  License grant this usage is measured against, same shape as value. Null when
  the license grants no value; -1 means unlimited for a NUMBER entitlement.
  """
  limit: Map

  """
  Start of the current usage window (inclusive). Null for a lifetime
  entitlement (no configured reset period).
  """
  currentPeriodStart: Time

  """
  End of the current usage window (exclusive). Null for a lifetime
  entitlement (no configured reset period).
  """
  currentPeriodEnd: Time

  source: EntitlementUsageSource!

  """
  How far above limit usage is still accepted, in percent: -1 unlimited, 0 a
  hard limit. Null for BOOLEAN and CONFIG.
  """
  limitCapExceededOveragePercent: Int

  """
  What the licence, the add-ons, the boosts and the exception each
  contribute, as the REST gauge read returns it.
  """
  provenance: Map

  """
  The resource this usage counts. Null on an entitlement's own usage, which is
  the only usage this type carries today.
  """
  resourceKey: String

  """
  Only on a RESOURCE entitlement: value is its highest counter and limit the
  limit of each resource; this says how many resources hold a counter and how
  many have reached the limit.
  """
  resources: EntitlementUsageResources
}

extend type Instance {
  """
  Current entitlement usage for this instance (one row per license grant)
  """
  entitlementUsage: [EntitlementUsage!]!
}
