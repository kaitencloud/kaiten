"""
An add-on version an instance holds, and how many units.
"""
type InstanceAddon {
  id: UUID!
  addonId: UUID!
  addonSlug: String!
  familySlug: String!
  name: String!
  quantity: Int!
  """The most one instance may hold; null when unbounded."""
  maxQuantity: Int
  """
  A decrease scheduled for the next boundary, 0 for a removal; null when
  nothing is scheduled.
  """
  pendingQuantity: Int
  attachedAt: Time!
}

extend type Instance {
  """
  The add-ons the instance holds now, oldest attachment first. Like the REST
  list, it needs billing to be enabled for the organization.
  """
  addons: [InstanceAddon!]!
}

"""The lifecycle of an add-on version."""
enum AddonLifecycleState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

"""How a mid-period increase of an add-on family's ADVANCE add-ons is billed."""
enum IncreaseBilling {
  TRUE_UP
  NEXT_BOUNDARY
}

"""
An add-on version: what a voucher names an add-on by, and the prices it
is sold at. The versions of one product share a name, so the version tells them
apart.
"""
type Addon {
  id: UUID!
  slug: String!
  """The family the version belongs to."""
  familySlug: String!
  name: String!
  description: String!
  """The version number in its family."""
  version: Int!
  versionName: String!
  """The version the family resolves to. Only a PUBLISHED version."""
  isDefault: Boolean!
  lifecycleState: AddonLifecycleState!
  """How this version is sold."""
  pricingType: PricingType!
  """The most one instance may hold; null when unbounded."""
  maxQuantity: Int
  """The family's: how a mid-period increase of its ADVANCE add-ons is billed."""
  increaseBilling: IncreaseBilling!
  """The version's prices in display order; status narrows them."""
  prices(status: PriceStatus): [AddonPrice!]!
}

"""
A price of an add-on version. It has the shape of a licence price.
Amounts are in minor units of currency; unitAmountDecimal is the amount.
"""
type AddonPrice {
  id: UUID!
  billingModel: PriceBillingModel!
  billingTiming: PriceBillingTiming!
  """Null on a metered price."""
  billingPeriod: PriceBillingPeriod
  currency: String!
  """The amount in minor units, up to 12 decimal places."""
  unitAmountDecimal: String!
  """The slug of the entitlement a metered price measures; null on a flat fee."""
  meteredEntitlement: String
  """Measured units in one sale unit of a metered price; null on a flat fee."""
  saleUnitFactor: String
  displayLabel: String
  displayOrder: Int!
  isDefault: Boolean!
  status: PriceStatus!
  deprecatedAt: Time
}

"""How a NUMBER grant of an add-on combines with the licence's own."""
enum AddonOverrideBehavior {
  ADD
  OVERRIDE
  MAX
}

"""
An entitlement an add-on version grants, on a licence it fits: one way an
instance of that licence can come to hold the entitlement without the licence
granting it.

An add-on attaches to an instance, never to a licence. What ties it to a
licence is compatibility, declared per add-on version against a licence
FAMILY: the grants are therefore the same for every version of a family.
Nothing here says an instance holds the add-on; Instance.addons does.
"""
type LicenseAddonGrant {
  entitlementSlug: String!
  entitlementType: String!
  addonId: UUID!
  """The add-on version: what an attachment names."""
  addonSlug: String!
  addonFamilySlug: String!
  addonName: String!
  """The version number in its add-on family."""
  addonVersion: Int!
  """
  DRAFT: attachable to an instance with no live subscription only. PUBLISHED:
  attachable. ARCHIVED: no new attachment, the instances that hold it keep it
  and its grant.
  """
  lifecycleState: AddonLifecycleState!
  """The version its add-on family resolves to. Only a PUBLISHED version."""
  isDefault: Boolean!
  """The most one instance may hold; null when unbounded."""
  maxQuantity: Int
  """
  The grant per unit of quantity, shaped like a licence grant:
  {type:"number",value:N}, {type:"boolean",value:B}, {type:"object",value:{...}}.
  """
  value: Map!
  """True when the value is the unlimited sentinel."""
  unlimited: Boolean!
  """
  The overage the add-on allows; null inherits the licence grant's (0 for an
  entitlement only add-ons grant).
  """
  limitCapExceededOveragePercent: Int
  """
  How a number grant combines with the licence's: ADD sums value x quantity,
  OVERRIDE replaces it with the latest attached add-on's, MAX keeps the larger.
  A boolean always ORs, a config always overrides.
  """
  overrideBehavior: AddonOverrideBehavior!
}

extend type License {
  """
  What add-ons can grant on this licence: every entitlement of every add-on
  version compatible with the licence's family, optionally one entitlement.
  The licence's own grants are License.entitlements. Like the REST add-on
  catalogue, it needs billing to be enabled for the organization, and
  read:addons.
  """
  addonGrants(entitlementSlug: String): [LicenseAddonGrant!]!
}

"""
A cursor-paginated page of add-on versions.
"""
type AddonPage {
  items: [Addon!]!
  """Opaque cursor for the next page. Null when hasMore is false."""
  nextCursor: String
  hasMore: Boolean!
}

extend type Query {
  """
  The organization's add-on versions, newest first, cursor-paginated. Like the
  REST list, it needs billing to be enabled for the organization.
  """
  addons(limit: Int, cursor: String): AddonPage!
}
